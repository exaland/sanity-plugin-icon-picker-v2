{
  "name": "sanity-plugin-icon-picker-v2",
  "version": "1.0.4",
  "description": "An Icon Picker plugin for Sanity",
  "keywords": [
    "sanity",
    "sanity-plugin",
    "plugin",
    "icon",
    "custom input",
    "sanity field"
  ],
  "homepage": "https://github.com/exaland/sanity-plugin-icon-picker-v2#readme",
  "bugs": {
    "url": "https://github.com/exaland/sanity-plugin-icon-picker-v2/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/exaland/sanity-plugin-icon-picker-v2.git"
  },
  "license": "MIT",
  "author": "Alexandre Magnier - Exaland Concept <exaland@gmail.com>",
  "contributors": [
    "Christopher Afbjur"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.esm.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.esm.js",
  "types": "./dist/index.esm.d.ts",
  "type": "module",
  "files": [
    "dist",
    "sanity.json",
    "src",
    "v2-incompatible.js"
  ],
  "scripts": {
    "build": "run-s clean && plugin-kit verify-package --silent && pkg-utils build --strict && pkg-utils --strict",
    "check-types": "tsc --noEmit",
    "clean": "rimraf dist",
    "format": "prettier --write --cache --ignore-unknown .",
    "format:check": "prettier --check .",
    "link-watch": "plugin-kit link-watch",
    "lint": "eslint . --fix --ext .js,.jsx,.ts,.tsx",
    "lint:check": "eslint . --ext .js,.jsx,.ts,.tsx",
    "prepare": "husky install",
    "prepublishOnly": "run-s build",
    "test": "vitest run",
    "test:watch": "vitest",
    "watch": "pkg-utils watch --strict"
  },
  "dependencies": {
    "@sanity/incompatible-plugin": "^1.0.4",
    "@sanity/ui": "^3.1.11",
    "decamelize": "6.0.1",
    "framework7-icons": "^5.0.5",
    "react-icons": "^5.6.0",
    "react-virtualized-auto-sizer": "^1.0.5",
    "react-window": "^1.8.6",
    "sanity": "^5.8.1",
    "styled-components": "^6.3.8"
  },
  "devDependencies": {
    "@sanity/pkg-utils": "^10.4.4",
    "@sanity/plugin-kit": "^4.0.20",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.0.28 || ^19.0.0",
    "@types/react-virtualized-auto-sizer": "^1.0.8",
    "@types/react-window": "^1.8.6",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-sanity": "^7.1.4",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-unused-imports": "^4.3.0",
    "eslint-plugin-vitest": "^0.5.4",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.1",
    "prettier-plugin-packagejson": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-is": "^19.0.0",
    "rimraf": "^6.1.2",
    "ts-node": "^10.9.1",
    "typescript": "^5.8.2",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-is": "19.2.4",
    "sanity": "^5.8.1"
  },
  "engines": {
    "node": ">=18"
  },
  "sanityExchangeUrl": "https://www.sanity.io/plugins/icon-picker-v2",
  "sanityPlugin": {
    "verifyPackage": {
      "scripts": false
    }
  }
}
